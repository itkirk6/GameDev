    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: dialogue
      value: 
      objectReference: {fileID: 592572408}
    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: isQuestNpc
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: characterName
      value: John Wayne
      objectReference: {fileID: 0}
    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: multipleLines.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: completedLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: 'multipleLines.Array.data[0]'
      value: This might not be the best time, but I got a job if you want it.
      objectReference: {fileID: 0}
    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: 'multipleLines.Array.data[1]'
      value: or more like a hit...
      objectReference: {fileID: 0}
    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: 'multipleLines.Array.data[2]'
      value: you see theres a prisoner named Cole Maxton that jumped me with a bunch
        of his crones the otherday.
      objectReference: {fileID: 0}
    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: 'multipleLines.Array.data[3]'
      value: I want revenge on that bastard, but I cant get in anymore trouble than
        I already am.
      objectReference: {fileID: 0}
    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: 'multipleLines.Array.data[4]'
      value: So thats where you come in and beat the crap out of him for me!
      objectReference: {fileID: 0}
    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: 'multipleLines.Array.data[5]'
      value: Though I need it to be a little more violent... lets say with a rock
        to the head.
      objectReference: {fileID: 0}
    - target: {fileID: 8365984140137022275, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
      propertyPath: 'multipleLines.Array.data[6]'
      value: You do this for me and I'll tell you where I burried some wire cutters
        in the CourtYard.
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 4524c014f7461fa46af879a9f1f57eb1, type: 3}
