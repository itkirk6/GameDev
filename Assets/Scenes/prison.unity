  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a2c93950dbf8a64eb7f995dfca58159, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTestScript
  dialogue: {fileID: 2113514275}
  characterName: Waltuh "The Glutton"
  singleLine: 
  multipleLines:
  - HEY YOU!
  - The guards won't let me out mah cell cause I stole food while workin the caffeteria.
  - If you give me your portion of food today I'll give you the key to the kitchen
    I yoinked before I was caught.
  - You get me some food, and I'll give you the key.
  completedLines:
  - Ah you're a life saver man, heres that key I promised.
  delayBetweenLines: 4
  typingSpeed: 0.02
  isQuestNpc: 1
  requiredItemName: Food
  rewardItemPrefab: {fileID: 3698358983778486349, guid: db6c1f442a4a1414c9cfaac5627bb4a6, type: 3}
  rewardDropPoint: {fileID: 922454219}
